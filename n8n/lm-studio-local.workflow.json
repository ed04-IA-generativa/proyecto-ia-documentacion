      "parameters": {
        "method": "POST",
        "url": "https://host.docker.internal:7225/api/v1/conocimiento/documentos",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $('Login').item.json.data[0].token }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"modulo\": \"Inventario\", \"tipoDocumento\": \"Categoria\", \"referenciaId\": \"1-lmstudio\", \"contenido\": \"Sección de ferretería: martillos, destornilladores, llaves inglesas y pinzas para trabajos generales\", \"embedding\": $json.data[0].embedding } }}",
        "options": { "allowUnauthorizedCerts": true }
      }
    },
    {
      "id": "5344baf2-1576-4ad1-ad2b-b3557240e6c6",
      "name": "Generar Embedding LM Studio (Buscar)",
