        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $('Login').item.json.data[0].token }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"topN\": 10 } }}",
        "options": { "allowUnauthorizedCerts": true }
      }
    }
  ],
  "connections": {
