        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"embedding\": $json.data[0].embedding, \"modulo\": \"Inventario\", \"topN\": 5 } }}",
        "options": { "allowUnauthorizedCerts": true }
      }
    },
    {
      "id": "f0007b44-ebd3-410f-aa39-72fbb1df6776",
