      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [432, 304],
      "parameters": {
        "method": "POST",
        "url": "https://host.docker.internal:7225/api/auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": { "pOpcion": 1, "pUserName": "<usuario>", "pPass": "<contraseña>" },
        "options": { "allowUnauthorizedCerts": true }
      }
    },
    {
      "id": "1ad4fa9e-e454-4696-a648-667090f24275",
      "name": "Generar Embedding LM Studio (Indexar)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [512, 512],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:1234/v1/embeddings",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "model": "text-embedding-nomic-embed-text-v1.5",
          "input": "Sección de ferretería: martillos, destornilladores, llaves inglesas y pinzas para trabajos generales"
        }
      }
    },
    {
      "id": "ab38a140-04cc-408f-bab1-2b549128d99a",
