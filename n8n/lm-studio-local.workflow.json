      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [1024, 304],
      "parameters": {
        "method": "POST",
        "url": "https://host.docker.internal:7225/api/v1/conocimiento/buscar",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $('Login').item.json.data[0].token }}" }
